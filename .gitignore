# Secrets and local config
.env
.env.*
!.env.example

# Personal documentation stays local
*.md
!README.md
!technical_report.md

# Model weights and checkpoints — do not commit these
*.bin
*.safetensors
*.gguf
*.ckpt
*.pt

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
build/

# OS and editor
.DS_Store
.idea/
.vscode/

# Local experiments and generated evaluation artifacts
/track_2a/src/experiments/
/track_2a/data/runs/
/track_2a/data/manual_review/
# Evaluation fixtures stay local; public coaching guidance remains versionable
/track_2a/data/evaluation/*
!/track_2a/data/evaluation/README.md
!/track_2a/data/evaluation/references/
/track_2a/data/evaluation/references/*
!/track_2a/data/evaluation/references/criteria.json
!/track_2a/data/evaluation/references/feedback_guidelines.json
